<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Student Attendance Register" android:textSize="20sp" android:textStyle="bold" android:gravity="center" android:layout_marginBottom="16dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <EditText android:id="@+id/etStudentName" android:layout_width="0dp" android:layout_weight="1" android:layout_height="50dp" android:hint="Enter student name"/>
        <Button android:id="@+id/btnAdd" android:layout_width="wrap_content" android:layout_height="50dp" android:text="Add" android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
        <TextView android:id="@+id/tvTotal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Total: 0" android:gravity="center" android:textStyle="bold"/>
        <TextView android:id="@+id/tvPresent" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Present: 0" android:gravity="center" android:textStyle="bold"/>
        <TextView android:id="@+id/tvAbsent" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Absent: 0" android:gravity="center" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No students added yet." android:gravity="center" android:layout_marginTop="30dp"/>
    <ListView android:id="@+id/listViewStudents" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp"/>
    <Button android:id="@+id/btnReset" android:layout_width="match_parent" android:layout_height="50dp" android:text="Reset Register" android:layout_marginTop="8dp"/>
</LinearLayout>